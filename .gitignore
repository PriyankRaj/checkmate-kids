# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/
/android/.gradle/

# Claude Code session state, not part of the app
/.claude/

# Release signing secrets — never commit to a public repo
/android/key.properties
/android/app/*.jks
/android/app/*.keystore
/android/play-deploy-key.json

# fastlane's own run report — regenerated every run, no lasting value in git
/fastlane/report.xml

# Local deploy history (used by the deploy dashboard) — machine-local state
.deploy-history.json
.last-failure.json

# Build artifacts inside vendored third-party packages
third_party/**/.cxx/
third_party/**/build/
